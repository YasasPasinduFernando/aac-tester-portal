{
  "name": "aac-tester-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AAC Sinhala closed-testing tester onboarding portal",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:d1:create": "wrangler d1 create aac-tester-portal",
    "cf:d1:migrate:local": "wrangler d1 migrations apply aac-tester-portal --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply aac-tester-portal --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
