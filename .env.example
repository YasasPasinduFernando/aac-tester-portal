# Public Play closed-testing join URL (not an API key).
# Example: https://play.google.com/apps/testing/lk.aac.sinhala_tamil_english
PLAY_TEST_JOIN_URL=

# Google Group used for Play closed testers
GOOGLE_GROUP_EMAIL=aac-sinhala-testers@googlegroups.com

# Apps Script web app URL and shared secret are Worker secrets.
# Do not put real values here. Use `wrangler secret put`.
# APPS_SCRIPT_URL=
# APPS_SCRIPT_SHARED_SECRET=

# Automatic removal is off by default. Do not enable until you
# understand Google Group mutation limits documented in the README.
ENABLE_AUTO_REMOVAL=false
TESTER_INACTIVITY_DAYS=90

# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=https://aac.yasaboy.com,http://localhost:5173,http://127.0.0.1:5173

# production | development
ENVIRONMENT=development

# Cloudflare Access (admin). Leave empty until Access is configured.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=

# Optional: enable Admin SDK Directory mutation attempts in Apps Script
# (Google Workspace domains only; consumer @googlegroups.com groups cannot use this)
ENABLE_ADMIN_DIRECTORY=false
